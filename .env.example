# Frame Matcher bot settings
# Copy this file as ".env" and fill in the token.

# BotFather se mila token = ke aage paste karo (koi space ya quotes nahi)
BOT_TOKEN=

# Roz kab auto check ho (stock, price, naye offer frames), 24-hour INDIA time (IST), comma se alag
# Server ka timezone kuch bhi ho, ye time India ke hisaab se hi chalega
# 00:00 = raat 12 baje, 13:00 = dopahar 1 baje
CHECK_TIMES=00:00,13:00

# Bot use karne se pehle ye channel join karna zaroori (khaali = sab use kar sakte hain)
# Public channel: @username   Private channel: -100xxxxxxxxxx|https://t.me/+invitelink
# Bot ko har channel mein admin banana zaroori hai, tabhi wo membership check kar payega
REQUIRED_CHANNELS=

# Naye user ka default max price
DEFAULT_BUDGET=1200
